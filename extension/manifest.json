{
  "manifest_version": 3,
  "name": "Qhaphela: Know before you apply",
  "version": "0.1.0",
  "description": "Flags fraudulent job postings for South African job seekers, with plain-language reasons instead of a silent block.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "*://*.google.com/*",
        "*://*.bing.com/*",
        "*://*.duckduckgo.com/*",
        "*://mail.google.com/*",
        "*://*.outlook.com/*",
        "*://*.office.com/*",
        "*://*.live.com/*",
        "*://mail.yahoo.com/*",
        "*://*.proton.me/*",
        "*://*.protonmail.com/*",
        "*://*.zoho.com/*",
        "*://*.icloud.com/*",
        "*://*.standardbank.co.za/*",
        "*://*.fnb.co.za/*",
        "*://*.absa.co.za/*",
        "*://*.nedbank.co.za/*",
        "*://*.capitecbank.co.za/*",
        "*://*.tymebank.co.za/*",
        "*://*.africanbank.co.za/*",
        "*://*.investec.com/*",
        "*://*.discovery.co.za/*",
        "*://*.bidvestbank.co.za/*",
        "*://*.oldmutual.co.za/*",
        "*://*.sanlam.co.za/*",
        "*://*.bankofamerica.com/*",
        "*://*.sars.gov.za/*",
        "*://*.sarsefiling.co.za/*",
        "*://*.dha.gov.za/*",
        "*://*.paypal.com/*",
        "*://*.payfast.co.za/*",
        "*://*.ozow.com/*",
        "*://*.yoco.com/*",
        "*://*.peachpayments.com/*",
        "*://*.github.com/*",
        "*://*.gitlab.com/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/atkinson-regular.woff2",
        "fonts/atkinson-bold.woff2",
        "icons/logo-mark.png",
        "icons/watermark.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none'"
  },
  "minimum_chrome_version": "116"
}
