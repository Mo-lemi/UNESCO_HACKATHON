{
  "manifest_version": 3,
  "name": "Qhaphela: Know before you apply",
  "version": "0.1.0",
  "description": "Flags fraudulent job postings for South African job seekers, with plain-language reasons instead of a silent block.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "*://*.google.com/*",
        "*://*.bing.com/*",
        "*://*.duckduckgo.com/*",
        "*://mail.google.com/*",
        "*://*.outlook.com/*",
        "*://*.office.com/*",
        "*://*.bankofamerica.com/*",
        "*://*.standardbank.co.za/*",
        "*://*.fnb.co.za/*",
        "*://*.absa.co.za/*",
        "*://*.nedbank.co.za/*",
        "*://*.capitecbank.co.za/*",
        "*://*.sars.gov.za/*",
        "*://*.paypal.com/*",
        "*://*.github.com/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/atkinson-regular.woff2",
        "fonts/atkinson-bold.woff2",
        "icons/logo-mark.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}